{
    "version": 12,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "description": "Common output directories, diagnostics, and cache settings",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "graphviz": "dependencies.dot",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
,
        {
            "name": "vcpkg",
            "description": "Use vcpkg manifest mode as the primary package toolchain",
            "hidden": true,
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        }

,
        {
            "name": "windows",
            "displayName": "Windows",
            "hidden": true,
            "inherits": [
                "base",
                "vcpkg"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "description": "Common Windows configuration with vcpkg enabled by default"
        }








,
        {
            "name": "windows-arm64-msvc-vs2022",
            "displayName": "Windows ARM64 MSVC Visual Studio 2022",
            "inherits": [
                "windows"
            ],
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "arm64",
                "strategy": "set"
            },
            "cacheVariables": {
                
                "VCPKG_TARGET_TRIPLET": "arm64-windows",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/windows-arm64-msvc.cmake"
            },
            "description": "Configure Windows ARM64 MSVC Visual Studio 2022 using vcpkg and the selected target toolchain"
        }

,
        {
            "name": "windows-arm64-clang-cl-ninja-debug",
            "displayName": "Windows ARM64 Clang-CL Ninja Debug",
            "inherits": [
                "windows"
            ],
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                
                "VCPKG_TARGET_TRIPLET": "arm64-windows",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/windows-arm64-clang-cl.cmake"
            },
            "description": "Configure Windows ARM64 Clang-CL Ninja Debug using vcpkg and the selected target toolchain"
        }

,
        {
            "name": "windows-arm64-clang-cl-ninja-release",
            "displayName": "Windows ARM64 Clang-CL Ninja Release",
            "inherits": [
                "windows"
            ],
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                
                "VCPKG_TARGET_TRIPLET": "arm64-windows",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/windows-arm64-clang-cl.cmake"
            },
            "description": "Configure Windows ARM64 Clang-CL Ninja Release using vcpkg and the selected target toolchain"
        }

























