{
    "version": 12,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "description": "Common output directories, diagnostics, and cache settings",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "graphviz": "dependencies.dot",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
{% if use_vcpkg %}
        {
            "name": "vcpkg",
            "description": "Use vcpkg manifest mode as the primary package toolchain",
            "hidden": true,
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
{% endif %}
        {
            "name": "windows",
            "displayName": "Windows",
            "hidden": true,
            "inherits": [
                "base"{% if use_vcpkg %},
                "vcpkg"{% endif %}
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "description": "Common Windows configuration{% if use_vcpkg %} with vcpkg enabled by default{% endif %}"
        },
        {
            "name": "linux",
            "displayName": "Linux",
            "hidden": true,
            "inherits": [
                "base"{% if use_vcpkg %},
                "vcpkg"{% endif %}
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "description": "Common Linux configuration{% if use_vcpkg %} with vcpkg enabled by default{% endif %}"
        },
        {
            "name": "macos",
            "displayName": "macOS",
            "hidden": true,
            "inherits": [
                "base"{% if use_vcpkg %},
                "vcpkg"{% endif %}
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "description": "Common macOS configuration{% if use_vcpkg %} with vcpkg enabled by default{% endif %}"
        },
        {
            "name": "windows-x64-msvc-vs2022",
            "displayName": "Windows x64 MSVC Visual Studio 2022",
            "inherits": [
                "windows"
            ],
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
