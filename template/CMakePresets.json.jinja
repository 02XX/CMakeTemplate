{
    "version": 12,
    "cmakeMinimumRequired": {
        "major": {{ 4 if 'windows' in platforms and 'msvc' in windows_compilers and windows_vs_generator == 'Visual Studio 18 2026' else 3 }},
        "minor": {{ 2 if 'windows' in platforms and 'msvc' in windows_compilers and windows_vs_generator == 'Visual Studio 18 2026' else 31 }},
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "description": "Common output directories, diagnostics, and cache settings",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "graphviz": "dependencies.dot",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
{%- if use_vcpkg %},
        {
            "name": "vcpkg",
            "description": "Use vcpkg manifest mode as the primary package toolchain",
            "hidden": true,
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        }
{%- endif %}
{%- if 'windows' in platforms %},
        {
            "name": "windows",
            "displayName": "Windows",
            "hidden": true,
            "inherits": [
                "base"{% if use_vcpkg %},
                "vcpkg"{% endif %}
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "description": "Common Windows configuration{% if use_vcpkg %} with vcpkg enabled by default{% endif %}"
        }
{%- endif %}
{%- if 'linux' in platforms %},
        {
            "name": "linux",
            "displayName": "Linux",
            "hidden": true,
            "inherits": [
                "base"{% if use_vcpkg %},
                "vcpkg"{% endif %}
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "description": "Common Linux configuration{% if use_vcpkg %} with vcpkg enabled by default{% endif %}"
        }
{%- endif %}
{%- if 'macos' in platforms %},
        {
            "name": "macos",
            "displayName": "macOS",
            "hidden": true,
            "inherits": [
                "base"{% if use_vcpkg %},
                "vcpkg"{% endif %}
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "description": "Common macOS configuration{% if use_vcpkg %} with vcpkg enabled by default{% endif %}"
        }
{%- endif %}
{%- if 'windows' in platforms and 'x64' in architectures and 'msvc' in windows_compilers %},
        {
            "name": "windows-x64-msvc-vs",
            "displayName": "Windows x64 MSVC {{ windows_vs_generator }}",
            "inherits": [
                "windows"
            ],
            "generator": "{{ windows_vs_generator }}",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "cacheVariables": {
{%- if use_vcpkg %}
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/windows-x64-msvc.cmake"
{%- else %}
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/windows-x64-msvc.cmake"
{%- endif %}
            },
            "description": "Configure Windows x64 MSVC Visual Studio using {% if use_vcpkg %}vcpkg and {% endif %}the selected target toolchain"
        }
